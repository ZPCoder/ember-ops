{
  "schemaVersion": 1,
  "roomCount": 250,
  "logicalClients": 500,
  "protocolVersion": "1.0.0",
  "auth": {
    "header": "Authorization",
    "value": "Bearer {token}"
  },
  "endpoints": {
    "pairFirst": {
      "method": "POST",
      "path": "/v1/pvp/sessions",
      "acceptedStatuses": [200, 201],
      "headers": { "Idempotency-Key": "{idempotencyKey}" },
      "body": {
        "protocolVersion": "{protocolVersion}",
        "format": "standard",
        "deckId": "{deckId}"
      }
    },
    "pairSecond": {
      "method": "POST",
      "path": "/v1/pvp/sessions",
      "acceptedStatuses": [200, 201],
      "headers": { "Idempotency-Key": "{idempotencyKey}" },
      "body": {
        "protocolVersion": "{protocolVersion}",
        "format": "standard",
        "deckId": "{deckId}"
      }
    },
    "command": {
      "method": "POST",
      "path": "/v1/pvp/commands?matchId={matchId}",
      "acceptedStatuses": [200, 202],
      "headers": { "Idempotency-Key": "{idempotencyKey}" },
      "body": {
        "protocolVersion": "{protocolVersion}",
        "requestId": "{requestId}",
        "idempotencyKey": "{idempotencyKey}",
        "expectedVersion": "{expectedVersion}",
        "command": { "type": "concede" }
      }
    },
    "events": {
      "method": "GET",
      "path": "/v1/pvp/events?matchId={matchId}&after={cursor}",
      "acceptedStatuses": [200]
    },
    "reconnect": {
      "method": "GET",
      "path": "/v1/pvp/events?matchId={matchId}&after=0",
      "acceptedStatuses": [200],
      "headers": { "Connection": "close" }
    }
  },
  "snapshotPaths": {
    "matchId": "matchId",
    "stateVersion": "stateVersion",
    "cursor": "cursor"
  },
  "stream": {
    "envelopeMode": "object",
    "eventsPath": "events",
    "cursorPath": "cursor",
    "stateVersionPath": "stateVersion",
    "eventTypePath": "type",
    "correlationPath": "payload.requestId",
    "settlementIdPath": "payload.settlementId"
  },
  "eventTypes": {
    "commandAccepted": "command-accepted",
    "matchEnded": "match-ended"
  },
  "polling": {
    "attempts": 30,
    "intervalSeconds": 0.1
  }
}
