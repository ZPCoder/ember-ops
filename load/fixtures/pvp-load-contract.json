{
  "schemaVersion": 2,
  "roomCount": 250,
  "logicalClients": 500,
  "protocolVersion": "1.0",
  "auth": { "header": "Authorization", "value": "Bearer {token}" },
  "endpoints": {
    "command": {
      "method": "POST",
      "path": "/v1/pvp/commands?matchId={matchId}",
      "acceptedStatuses": [200, 202],
      "headers": { "Idempotency-Key": "{idempotencyKey}" },
      "body": {
        "protocolVersion": "{protocolVersion}",
        "requestId": "{requestId}",
        "idempotencyKey": "{idempotencyKey}",
        "expectedVersion": "{expectedVersion}",
        "command": { "type": "concede", "player": "{seat}" }
      }
    }
  },
  "websocket": {
    "path": "/v1/pvp/ws?matchId={matchId}&after={cursor}",
    "openTimeoutMs": 5000,
    "messageTimeoutMs": 5000,
    "disconnectCommandDelayMs": 250,
    "reconnectDelayMs": 500,
    "duplicateObservationMs": 500
  },
  "snapshotPaths": { "matchId": "matchId", "stateVersion": "stateVersion", "cursor": "cursor" },
  "stream": {
    "envelopeMode": "object",
    "matchIdPath": "matchId",
    "eventsPath": "events",
    "cursorPath": "cursor",
    "stateVersionPath": "stateVersion",
    "eventTypePath": "type",
    "correlationPath": "payload.requestId",
    "settlementIdPath": "payload.settlementId"
  },
  "eventTypes": { "commandAccepted": "command-accepted", "matchEnded": "match-ended" }
}
